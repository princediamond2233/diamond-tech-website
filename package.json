{
  "name": "diamond-tech-website",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "npm --prefix server run dev",
    "build:api": "npm --prefix server run build",
    "dev:all": "concurrently -n WEB,API \"npm run dev\" \"npm run dev:api\"",
    "build:all": "npm run build && npm run build:api"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "concurrently": "^9.1.2"
  }
}
